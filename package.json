{
  "name": "@dev-sergeev/datalab-kit",
  "version": "0.3.0",
  "description": "A one-time installer of independent Pi coding agent packages",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "gigachat"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "files": [
    "dist",
    "scripts/install.mjs",
    "docs/adr/0004-independent-component-installer.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "pi": {
    "extensions": []
  },
  "bin": {
    "datalab-kit": "./scripts/install.mjs"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --liftoff-only --test --test-concurrency=1 test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "latest",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
